{
  "name": "corpus-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:kernel": "tsc -p tsconfig.kernel.json",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:kernel": "npm run build:kernel && node --test tests/kernel.test.mjs",
    "test:intake": "npm run build:kernel && node --test tests/intake.test.mjs",
    "test:session": "npm run build:kernel && node --test tests/corpus-session.test.mjs tests/corpus-host-linux.test.mjs tests/mandatory-warrant-boundary.test.mjs tests/capability-policy.test.mjs",
    "test:trust": "npm run build:kernel && node --test tests/trust-runtime.test.mjs",
    "test:adoption": "npm run build:kernel && node --test tests/adopted-declaration.test.mjs",
    "test:warrant": "npm run build:kernel && node --test tests/adopted-warrant-root.test.mjs tests/warranted-execution.test.mjs",
    "test:causal": "npm run build:kernel && node --test tests/causal-accounting.test.mjs",
    "test:reachability": "npm run build:kernel && node --test tests/lawful-reachability.test.mjs tests/lawful-reachability-orphan-effects.test.mjs tests/lawful-reachability-boundary.test.mjs",
    "test:continuity": "npm run build:kernel && node --test tests/continuity-attestation.test.mjs",
    "test:latent": "npm run build:kernel && node --test tests/latent-reachability.test.mjs",
    "test:encounter": "npm run build:kernel && node --test tests/world-encounter-admission.test.mjs tests/world-encounter-phase-dispositions.test.mjs",
    "test:browser": "npm run build && npm run build:kernel && node --test tests/intake-browser.test.mjs",
    "verify:corpus": "npm run build:kernel && node .kernel-dist/scripts/verify-corpus.js",
    "corpus:session": "npm run build:kernel && node .kernel-dist/scripts/corpus-session.js",
    "world-encounter:stdio": "npm run build:kernel --silent && node .kernel-dist/scripts/world-encounter-stdio.js",
    "check": "npm run lint && npm run test:kernel && npm run test:intake && npm run test:session && npm run test:trust && npm run test:adoption && npm run test:warrant && npm run test:causal && npm run test:reachability && npm run test:continuity && npm run test:latent && npm run test:encounter && npm run verify:corpus && npm test",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "puppeteer-core": "24.0.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Corpus OS"
}
